# Elasticsearch Configuration
ES_ENDPOINT_URL=https://your-elasticsearch-endpoint.elastic.cloud:443
ES_API_KEY=your-elasticsearch-api-key-here

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Optional: Other configuration
INFERENCE_ID=.rainbow-sprinkles-elastic
AGENT_CHECK_INTERVAL_SECONDS=60
ENABLE_OTEL_EXPORTER=false