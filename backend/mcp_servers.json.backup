      "name": "Elastic Customer Success",
      "tools": {
        "customer-success_accountaccount-details": {
          "description": "Get comprehensive account information for a specific customer including account balance, type,  status, risk level, and account creation date. Use this when you have a customer's account number and need their  full account profile.",
          "enabled": true,
          "name": "customer-success_accountaccount-details",
          "parameters": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "additionalProperties": false,
            "properties": {
              "account_number": {
                "description": "The exact account number for the customer",
                "type": "string"
              }
            },
            "required": [
              "account_number"
            ],
            "type": "object"
          }
        },
        "customer-success_accountrecent-activity": {
          "description": "Get comprehensive recent account activity for a customer including trades, deposits, withdrawals,   and other account changes. Use this for a complete activity timeline when customers ask 'what happened with my  account' or need activity summaries.",
          "enabled": true,
          "name": "customer-success_accountrecent-activity",
          "parameters": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "additionalProperties": false,
            "properties": {
              "account_number": {
                "description": "The account number to get activity for",
                "type": "string"
              },
              "time_period": {
                "description": "How far back to look for activity. Format: 'X days', 'X weeks', 'X months'. Default should  be '30 days'",
                "type": "string"
              }
            },
            "required": [
              "account_number",
              "time_period"
            ],
            "type": "object"
          }
        },
        "customer-success_marketasset-details": {
          "description": "Get detailed information about a specific stock or asset including company name, sector, current  price, market cap, and key financial metrics. Use this when customers ask about specific stocks or investments.",
          "enabled": true,
          "name": "customer-success_marketasset-details",
          "parameters": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "additionalProperties": false,
            "properties": {
              "symbol": {
                "description": "The stock symbol (ticker) to get details for, e.g. 'AAPL', 'GOOGL', 'MSFT'",
                "type": "string"
              }
            },
            "required": [
              "symbol"
            ],
            "type": "object"
          }
        },
        "customer-success_portfoliocurrent-holdings": {
          "description": "Retrieve all current holdings for a customer's account including stock symbols, quantities,  current values, and performance metrics. Use this to show what investments a customer currently owns.",
          "enabled": true,
          "name": "customer-success_portfoliocurrent-holdings",
          "parameters": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "additionalProperties": false,
            "properties": {
              "account_number": {
                "description": "The account number to get holdings for",
                "type": "string"
              }
            },
            "required": [
              "account_number"
            ],
            "type": "object"
          }
        },
        "customer-success_portfolioperformance-summary": {
          "description": "Calculate portfolio performance metrics for a customer including total portfolio value, total  gain/loss, percentage returns, and asset allocation. Use this to provide customers with their portfolio performance   overview.",
          "enabled": true,
          "name": "customer-success_portfolioperformance-summary",
          "parameters": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "additionalProperties": false,
            "properties": {
              "account_number": {
                "description": "The account number to calculate performance for",
                "type": "string"
              }
            },
            "required": [
              "account_number"
            ],
            "type": "object"
          }
        },
        "customer-success_researchasset-news": {
          "description": "Find recent news articles related to a specific stock or asset. Use this when customers ask about news affecting their holdings or want to research a particular stock.",
          "enabled": true,
          "name": "customer-success_researchasset-news",
          "parameters": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "additionalProperties": false,
            "properties": {
              "symbol": {
                "description": "The stock symbol to find news for, e.g. 'AAPL'. Use wildcards '*AAPL*' to match within arrays",
                "type": "string"
              },
              "time_period": {
                "description": "How far back to search for news. Format: 'X days', 'X weeks'. Default should be '7 days'",
                "type": "string"
              }
            },
            "required": [
              "symbol",
              "time_period"
            ],
            "type": "object"
          }
        },
        "customer-success_searchcustomer-lookup": {
          "description": "Search for customers by name or account number. Returns customer details including contact information and account identifiers. Use this when the user wants to find a specific customer or when they provide partial customer information. IMPORTANT: Do NOT add wildcards (*) to search terms - partial matching is handled automatically by ES|QL CONTAINS.",
          "enabled": true,
          "name": "customer-success_searchcustomer-lookup",
          "parameters": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "additionalProperties": false,
            "properties": {
              "search_term": {
                "description": "Search term to match against customer name or account number. Do NOT add wildcards (*) - use exact search term as provided",
                "type": "string"
              }
            },
            "required": [
              "search_term"
            ],
            "type": "object"
          }
        },
        "customer-success_tradingrecent-trades": {
          "description": "Get recent trading activity for a customer's account including buy/sell transactions, quantities,   prices, and dates. Use this to help customers understand their recent trading history or troubleshoot  trade-related questions.",
          "enabled": true,
          "name": "customer-success_tradingrecent-trades",
          "parameters": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "additionalProperties": false,
            "properties": {
              "account_number": {
                "description": "The account number to get trades for",
                "type": "string"
              },
              "time_period": {
                "description": "How far back to look for trades. Format: 'X HOURS', 'X MINUTES', 'X SECONDS'. Default should be '8766 HOURS'. DO NOT USE 'DAYS', 'YEARS', 'MONTHS' - only HOURS/MINUTES/SECONDS are supported by TO_TIMEDURATION.",
                "type": "string"
              }
            },
            "required": [
              "account_number",
              "time_period"
            ],
            "type": "object"
          }
        },
        "platform_coreexecute_esql": {
          "description": "Execute an ES|QL query and return the results in a tabular format.\n\n**IMPORTANT**: This tool only **runs** queries; it does not write them.\nThink of this as the final step after a query has been prepared.\n\nYou **must** get the query from one of two sources before calling this tool:\n1.  The output of the `platform.core.generate_esql` tool (if the tool is available).\n2.  A verbatim query provided directly by the user.\n\nUnder no circumstances should you invent, guess, or modify a query yourself for this tool.\nIf you need a query, use the `platform.core.generate_esql` tool first.",
          "enabled": true,
          "name": "platform_coreexecute_esql",
          "parameters": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "additionalProperties": false,
            "properties": {
              "query": {
                "description": "The ES|QL query to execute",
                "type": "string"
              }
            },
            "required": [
              "query"
            ],
            "type": "object"
          }
        },
        "platform_coregenerate_esql": {
          "description": "Generate an ES|QL query from a natural language query.",
          "enabled": true,
          "name": "platform_coregenerate_esql",
          "parameters": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "additionalProperties": false,
            "properties": {
              "context": {
                "description": "(optional) Additional context that could be useful to generate the ES|QL query",
                "type": "string"
              },
              "index": {
                "description": "(optional) Index to search against. If not provided, will use the index explorer to find the best index to use.",
                "type": "string"
              },
              "query": {
                "description": "A natural language query to generate an ES|QL query from.",
                "type": "string"
              }
            },
            "required": [
              "query"
            ],
            "type": "object"
          }
        },
        "platform_coreget_document_by_id": {
          "description": "Retrieve the full content (source) of an Elasticsearch document based on its ID and index name.",
          "enabled": true,
          "name": "platform_coreget_document_by_id",
          "parameters": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "additionalProperties": false,
            "properties": {
              "id": {
                "description": "ID of the document to retrieve",
                "type": "string"
              },
              "index": {
                "description": "Name of the index to retrieve the document from",
                "type": "string"
              }
            },
            "required": [
              "id",
              "index"
            ],
            "type": "object"
          }
        },
        "platform_coreget_index_mapping": {
          "description": "Retrieve mappings for the specified index or indices.",
          "enabled": true,
          "name": "platform_coreget_index_mapping",
          "parameters": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "additionalProperties": false,
            "properties": {
              "indices": {
                "description": "List of indices to retrieve mappings for.",
                "items": {
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              }
            },
            "required": [
              "indices"
            ],
            "type": "object"
          }
        },
        "platform_coreindex_explorer": {
          "description": "List relevant indices, aliases and datastreams based on a natural language query.\n\nThe 'indexPattern' parameter can be used to filter indices by a specific pattern, e.g. 'foo*'.\nThis should *only* be used if you know what you're doing (e.g. if the user explicitly specified a pattern).\nOtherwise, leave it empty to search against all indices.\n\n*Example:*\nUser: \"Show me my latest alerts\"\nYou: call tool 'index_explorer' with { query: 'indices containing user alerts' }\nTool result: [{ type: \"index\", name: '.alerts' }]\n",
          "enabled": true,
          "name": "platform_coreindex_explorer",
          "parameters": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "additionalProperties": false,
            "properties": {
              "indexPattern": {
                "description": "(optional) Index pattern to filter indices by. Defaults to *.",
                "type": "string"
              },
              "limit": {
                "description": "(optional) Limit the max number of indices to return. Defaults to 1.",
                "type": "number"
              },
              "query": {
                "description": "A natural language query to infer which indices, aliases or datastreams to use.",
                "type": "string"
              }
            },
            "required": [
              "query"
            ],
            "type": "object"
          }
        },
        "platform_corelist_indices": {
          "description": "List the indices, aliases and datastreams from the Elasticsearch cluster.\n\nThe 'pattern' optional parameter is an index pattern which can be used to filter resources.\nThis parameter should only be used when you already know of a specific pattern to filter on,\ne.g. if the user provided one. Otherwise, do not try to invent or guess a pattern.",
          "enabled": true,
          "name": "platform_corelist_indices",
          "parameters": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "additionalProperties": false,
            "properties": {
              "pattern": {
                "default": "*",
                "description": "Index pattern to match Elasticsearch indices, aliases and datastream names.\n      - Correct examples: '.logs-*', '*data*', 'metrics-prod-*', 'my-specific-index', '*'\n      - Should only be used if you are certain of a specific index pattern to filter on. *Do not try to guess*.\n      - Defaults to '*' to match all indices.",
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "platform_coresearch": {
          "description": "A powerful tool for searching and analyzing data within your Elasticsearch cluster.\nIt supports both full-text relevance searches and structured analytical queries.\n\nUse this tool for any query that involves finding documents, counting, aggregating, or summarizing data from a known index.\n\nExamples of queries:\n- \"find articles about serverless architecture\"\n- \"search for support tickets mentioning 'billing issue' or 'refund request'\"\n- \"what is our policy on parental leave?\"\n- \"list all products where the category is 'electronics'\"\n- \"show me the last 5 documents from that index\"\n- \"show me the sales over the last year break down by month\"\n\nNote:\n- The 'index' parameter can be used to specify which index to search against.\n If not provided, the tool will decide itself which is the best index to use.\n- It is perfectly fine not to specify the 'index' parameter. It should only be specified when you already\n know about the index and fields you want to search on, e.g. if the user explicitly specified it.\n    ",
          "enabled": true,
          "name": "platform_coresearch",
          "parameters": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "additionalProperties": false,
            "properties": {
              "index": {
                "description": "(optional) Index to search against. If not provided, will automatically select the best index to use based on the query.",
                "type": "string"
              },
              "query": {
                "description": "A natural language query expressing the search request",
                "type": "string"
              }
            },
            "required": [
              "query"
            ],
            "type": "object"
          }
        }
      },
      "transport": "http",
      "url": "https://elastic-customer-success-b772ae.kb.us-central1.gcp.elastic.cloud:443/api/agent_builder/mcp",
