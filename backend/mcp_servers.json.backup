                "type": "string"
              },
              "index": {
                "description": "(optional) Index to search against. If not provided, will use the index explorer to find the best index to use.",
                "type": "string"
              },
              "query": {
                "description": "A natural language query to generate an ES|QL query from.",
                "type": "string"
              }
            },
            "required": [
              "query"
            ],
            "type": "object"
          }
        },
