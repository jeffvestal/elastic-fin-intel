        "customer-success_searchcustomer-lookup": {
          "description": "Search for customers by name or account number. Returns customer details including contact information and account identifiers. Use this when the user wants to find a specific customer or when they provide partial customer information. IMPORTANT: Do NOT add wildcards (*) to search terms - partial matching is handled automatically by ES|QL CONTAINS.",
          "enabled": true,
          "name": "customer-success_searchcustomer-lookup",
          "parameters": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "additionalProperties": false,
            "properties": {
              "search_term": {
                "description": "Search term to match against customer name or account number. Do NOT add wildcards (*) - use exact search term as provided",
                "type": "string"
              }
            },
            "required": [
              "search_term"
            ],
            "type": "object"
          }
        },
